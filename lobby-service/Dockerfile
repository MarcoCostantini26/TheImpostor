FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /app

# Copy the gradle wrapper and properties
COPY gradlew .
COPY gradle gradle

# Make gradle wrapper executable
RUN chmod +x gradlew

# Copy build script and settings
COPY build.gradle.kts .
COPY settings.gradle.kts .

# Download dependencies (this step is cached unless build files change)
RUN ./gradlew dependencies --no-daemon

# Copy the source code
COPY src src

# Build the project, skipping tests since they are run in a previous step in CI
RUN ./gradlew build -x test --no-daemon

# --- Runtime Stage ---
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy the built jar from the builder stage
# Notice we rely on the typical spring boot jar name generated by the boot jar task
COPY --from=builder /app/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
